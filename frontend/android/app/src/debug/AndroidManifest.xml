<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- GPS — precise location while app is open -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- GPS — coarse fallback (required alongside FINE) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- GPS — needed for location updates when app is backgrounded -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!-- Notifications — required on Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Keeps CPU alive long enough to fire a notification when a location event arrives -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

</manifest>